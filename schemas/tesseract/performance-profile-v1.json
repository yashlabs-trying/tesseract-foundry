{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tesseract.performance-profile.v1",
  "title": "Tesseract Performance Profile",
  "description": "Canonical flat-metric performance profile for Tesseract platform integration. Foundry generates; Fusion/Ignite consume via REST.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "tesseract.performance-profile.v1",
      "description": "Immutable schema version identifier"
    },
    "profile_id": {
      "type": "string"
    },
    "model_id": {
      "type": "string"
    },
    "model_revision": {
      "type": "string"
    },
    "model_parameter_count": {
      "type": "integer",
      "minimum": 1
    },
    "hardware_id": {
      "type": "string"
    },
    "hardware_gpu_model": {
      "type": "string"
    },
    "hardware_gpu_count": {
      "type": "integer",
      "minimum": 1
    },
    "hardware_vram_gb": {
      "type": "number",
      "minimum": 0
    },
    "engine": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "synthetic",
        "estimated",
        "measured",
        "validated"
      ]
    },
    "benchmark_tool": {
      "type": "string"
    },
    "benchmark_version": {
      "type": "string"
    },
    "workload_id": {
      "type": "string"
    },
    "workload_concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "workload_input_token_mean": {
      "type": "number",
      "minimum": 1
    },
    "workload_output_token_mean": {
      "type": "number",
      "minimum": 1
    },
    "ttft_p50_ms": {
      "type": "number",
      "minimum": 0
    },
    "ttft_p95_ms": {
      "type": "number",
      "minimum": 0
    },
    "ttft_p99_ms": {
      "type": "number",
      "minimum": 0
    },
    "itl_p50_ms": {
      "type": "number",
      "minimum": 0
    },
    "itl_p95_ms": {
      "type": "number",
      "minimum": 0
    },
    "itl_p99_ms": {
      "type": "number",
      "minimum": 0
    },
    "request_latency_p50_ms": {
      "type": "number",
      "minimum": 0
    },
    "request_latency_p95_ms": {
      "type": "number",
      "minimum": 0
    },
    "request_latency_p99_ms": {
      "type": "number",
      "minimum": 0
    },
    "completed_requests_per_second": {
      "type": "number",
      "minimum": 0
    },
    "input_tokens_per_second": {
      "type": "number",
      "minimum": 0
    },
    "output_tokens_per_second": {
      "type": "number",
      "minimum": 0
    },
    "error_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "collection_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "test_fixture",
        "benchmark",
        "profiler",
        "external"
      ]
    },
    "source_artifact_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile_id",
    "model_id",
    "model_revision",
    "hardware_id",
    "engine",
    "evidence_type",
    "collection_timestamp",
    "source_type"
  ]
}